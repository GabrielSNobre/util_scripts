#!/bin/sh

SRC_DIR="src"
OUT_DIR="bin"
LIB_DIR="lib"

# Function to build classpath with lib directory
build_classpath() {
    CLASSPATH="$OUT_DIR"
    
    if [ -d "$LIB_DIR" ]; then
        for jar in "$LIB_DIR"/*.jar; do
            if [ -f "$jar" ]; then
                CLASSPATH="$CLASSPATH:$jar"
            fi
        done
    fi
    
    echo "$CLASSPATH"
}

find_main_class() {
    MAIN_FILE=$(find "$SRC_DIR" -name "*.java" -exec grep -l "public static void main" {} \; | head -1)
    
    if [ -z "$MAIN_FILE" ]; then
        echo "Error: Could not find a class with main method"
        exit 1
    fi
    
    MAIN_CLASS=$(echo "$MAIN_FILE" | sed "s|$SRC_DIR/||" | sed 's|/|.|g' | sed 's|.java||')
    echo "$MAIN_CLASS"
}

compile(){
    echo "Compiling..."
    mkdir -p "$OUT_DIR"
    
    # Build classpath for compilation
    CP=""
    if [ -d "$LIB_DIR" ]; then
        for jar in "$LIB_DIR"/*.jar; do
            if [ -f "$jar" ]; then
                if [ -z "$CP" ]; then
                    CP="$jar"
                else
                    CP="$CP:$jar"
                fi
            fi
        done
    fi
    
    # Compile with classpath if libraries exist
    if [ -n "$CP" ]; then
        echo "Using libraries from $LIB_DIR"
        javac -cp "$CP" -d "$OUT_DIR" $(find "$SRC_DIR" -name "*.java")
    else
        javac -d "$OUT_DIR" $(find "$SRC_DIR" -name "*.java")
    fi
    
    if [ $? -eq 0 ]; then
        echo "Compilation successful!"
    else
        echo "Compilation failed!"
        exit 1
    fi
}

case "$1" in 
    build | -b)
        compile
        ;;
    run | -r)
        MAIN_CLASS=$(find_main_class)
        if [ -n "$MAIN_CLASS" ]; then
            echo "Running: $MAIN_CLASS"
            CLASSPATH=$(build_classpath)
            java -cp "$CLASSPATH" "$MAIN_CLASS"
        fi
        ;;
    clean | -c)
        echo "Cleaning bin directory..."
        rm -rf "$OUT_DIR"
        echo "Done!"
        ;;
    help | -h)
        echo "Java Compilation Utility"
        echo "Commands:"
        echo "  help    | -h     - Show this help message"
        echo "  run     | -r     - Run the main class"
        echo "  build   | -b     - Compile the project"
        echo "  clean   | -c     - Clean the bin directory"
        echo ""
        echo "Project structure:"
        echo "  src/     - Java source files"
        echo "  bin/     - Compiled classes"
        echo "  lib/     - External JAR dependencies (e.g., mariadb connector)"
        ;;
    *)
        echo "Unknown argument: $1"
        echo "Use 'help' or '-h' for available commands"
        exit 1
        ;;
esac
